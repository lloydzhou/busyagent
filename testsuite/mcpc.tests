#!/bin/sh
# testsuite/mcpc.tests - mcpc applet tests
#
# stdio transport runs a local echo MCP server (echo-mcp.tmp.sh); the HTTP
# transport runs a busybox httpd CGI endpoint that speaks the same
# JSON-RPC and returns a fixed Mcp-Session-Id so cross-invocation
# session reuse can be asserted from the request log.

. ./testing.sh

HOME_FILTER='s|/[^ ]*mcpc[^ ]*|MCPC_HOME|g'

# === stdio transport ================================================

# self-contained stdio server (heredoc: no dependency on the source
# tree - the runner executes us with the testsuite as cwd)
cat > echo-mcp.tmp.sh <<'ECHO'
#!/bin/sh
while IFS= read -r line; do
	method=$(printf '%s' "$line" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
	id=$(printf '%s' "$line" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
	printf '%s\n' "$line" >> "__STDIO_LOG__"
	case "$method" in
	initialize)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"echo-mcp","version":"1.0"}}}\n' "$id"
		;;
	notifications/*)
		:   # notifications get no response
		;;
	tools/list)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[{"name":"echo","description":"echo back its arguments","inputSchema":{"type":"object","properties":{"msg":{"type":"string"}}}},{"name":"add","description":"add two numbers","inputSchema":{"type":"object"}}]}}\n' "$id"
		;;
	tools/call)
		case "$line" in
		*'"name":"nope"'*)
			printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"tool not found"}}\n' "$id"
			;;
		*)
			printf '{"jsonrpc":"2.0","id":%s,"result":{"content":[{"type":"text","text":"echo-called"}],"isError":false}}\n' "$id"
			;;
		esac
		;;
	ping)
		printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
		;;
	*)
		printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"unknown method %s"}}\n' "$id" "$method"
		;;
	esac
done
ECHO
sed -i "s|__STDIO_LOG__|$PWD/mcpc-stdio.log|" echo-mcp.tmp.sh
chmod +x echo-mcp.tmp.sh

rm -rf mc.home
rm -f mcpc-stdio.log

testing "mcpc without arguments shows usage" \
	'mcpc 2>&1 | grep -c "Usage: mcpc" || true' \
	"1\n" \
	"" ""

testing "mcpc connect spawns a stdio session (and the daemon)" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh @echo 2>&1' \
	"connected @echo\n" \
	"" ""

testing "mcpc ls shows the live session" \
	'BA_HOME=$PWD/mc.home mcpc ls 2>&1 | grep -c "@echo.*stdio.*live"' \
	"1\n" \
	"" ""

testing "mcpc tools-list lists cached tools" \
	'BA_HOME=$PWD/mc.home mcpc @echo tools-list 2>&1 | tr -s " "' \
	"echo echo back its arguments
add add two numbers\n" \
	"" ""

testing "mcpc tools-get shows one schema" \
	'BA_HOME=$PWD/mc.home mcpc @echo tools-get echo 2>&1 | grep -c "\"name\":\"echo\""' \
	"1\n" \
	"" ""

testing "mcpc tools-call works over stdio" \
	'BA_HOME=$PWD/mc.home mcpc @echo tools-call echo msg:=42 2>&1' \
	'{"content":[{"type":"text","text":"echo-called"}],"isError":false}\n' \
	"" ""

testing "mcpc tools-call delivers object arguments to the server" \
	'grep -c "\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"msg\":42}}" mcpc-stdio.log' \
	"1\n" \
	"" ""

testing "mcpc ping answers" \
	'BA_HOME=$PWD/mc.home mcpc @echo ping 2>&1' \
	"pong @echo\n" \
	"" ""

testing "mcpc ping on a missing session fails nonzero" \
	'BA_HOME=$PWD/mc.home mcpc @nosuch ping >/dev/null 2>&1; echo rc=$?' \
	"rc=1\n" \
	"" ""

testing "mcpc connect --protocol-version reaches the handshake" \
	'BA_HOME=$PWD/mc2.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh @old --protocol-version 2024-11-05 2>&1; grep -c "\"protocolVersion\":\"2024-11-05\"" mcpc-stdio.log' \
	"connected @old
1\n" \
	"" ""

testing "mcpc grep searches cached tools" \
	'BA_HOME=$PWD/mc.home mcpc grep numbers 2>&1 | tr -s " "' \
	"echo add\n" \
	"" ""

# === review-fix coverage (stdio) =====================================

# the embedded echo server answers unknown tools with a JSON-RPC error
# (same as testsuite/echo-mcp.sh); the CLI surfaces it
testing "mcpc surfaces a JSON-RPC error from the server" \
	'BA_HOME=$PWD/mc.home mcpc @echo tools-call nope 2>&1; echo rc=$?' \
	'{"code":-32601,"message":"tool not found"}
rc=1\n' \
	"" ""

# a 20 KB tools/list must come through connect and tools-list intact
cat > echo-big.tmp.sh <<'ECHO'
#!/bin/sh
while IFS= read -r line; do
	method=$(printf '%s' "$line" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
	id=$(printf '%s' "$line" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
	case "$method" in
	initialize)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"big","version":"1.0"}}}\n' "$id"
		;;
	notifications/*)
		:
		;;
	tools/list)
		desc=$(awk 'BEGIN{for(i=0;i<20000;i++)printf "x"}')
		printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[{"name":"t1","description":"%s"}]}}\n' "$id" "$desc"
		;;
	*)
		printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
		;;
	esac
done
ECHO
chmod +x echo-big.tmp.sh

testing "mcpc connects through a 20 KB tools/list" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-big.tmp.sh @big 2>&1 && BA_HOME=$PWD/mc.home mcpc @big tools-list 2>&1 | wc -c' \
	"connected @big
20026\n" \
	"" ""

# with the cache deleted, tools-list falls back to the daemon's copy
testing "mcpc tools-list daemon fallback carries the full array" \
	'rm -f mc.home/mcpc/servers/big.json && BA_HOME=$PWD/mc.home mcpc @big tools-list 2>&1 | wc -c' \
	"20026\n" \
	"" ""

# a session whose server exits must drop out of ls (not linger dead)
cat > echo-die.tmp.sh <<'ECHO'
#!/bin/sh
n=0
while IFS= read -r line; do
	n=$((n+1))
	method=$(printf '%s' "$line" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
	id=$(printf '%s' "$line" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
	case "$method" in
	initialize)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"die","version":"1.0"}}}\n' "$id"
		;;
	notifications/*)
		:
		;;
	tools/list)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[]}}\n' "$id"
		;;
	*)
		printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
		;;
	esac
	if [ "$n" -ge 4 ]; then exit 0; fi
done
ECHO
chmod +x echo-die.tmp.sh

testing "mcpc retires a session whose server died" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-die.tmp.sh @doomed >/dev/null 2>&1; BA_HOME=$PWD/mc.home mcpc @doomed tools-call nope >/dev/null 2>&1; BA_HOME=$PWD/mc.home mcpc @doomed tools-call nope >/dev/null 2>&1; BA_HOME=$PWD/mc.home mcpc @doomed tools-call nope >/dev/null 2>&1; BA_HOME=$PWD/mc.home mcpc ls 2>&1 | grep -c "@doomed" || true' \
	"0\n" \
	"" ""

# names with quotes stay valid JSON in ls --json
testing "mcpc ls --json escapes a quoted session name" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh "@we\"ird" >/dev/null 2>&1 && BA_HOME=$PWD/mc.home mcpc ls --json 2>&1 | grep -cF "name\":\"we\\\"ird" || true' \
	"1\n" \
	"" ""

# removing the socket of a live daemon must self-heal on the next command
testing "mcpc recovers when the daemon socket is removed" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh @base >/dev/null 2>&1 && rm -f mc.home/mcpc/daemon.sock && BA_HOME=$PWD/mc.home mcpc ls >/dev/null 2>&1 && BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh @echo >/dev/null 2>&1; test $(cat mc.home/mcpc/daemon.pid) -gt 0 && echo pidfile-ok' \
	"pidfile-ok\n" \
	"" ""

testing "mcpc close drops the session, cache survives" \
	'BA_HOME=$PWD/mc.home mcpc close @echo && BA_HOME=$PWD/mc.home mcpc @echo tools-list 2>&1 | head -1 | tr -s " "; BA_HOME=$PWD/mc.home mcpc @echo tools-call echo 2>&1 | grep -c "no live session" || true' \
	"closed @echo
echo echo back its arguments
1\n" \
	"" ""

# === HTTP transport =================================================

optional HTTPD FEATURE_HTTPD_CGI

if [ -z "$SKIP" ]; then
	ROOT=$PWD/mc.e2e
	WEB=$ROOT/www
	PORT=$((21000 + $$ % 20000))

	rm -rf "$ROOT"
	mkdir -p "$WEB/cgi-bin"

	cat > "$WEB/cgi-bin/mcp" <<'CGI'
#!/bin/sh
# Streamable-HTTP MCP endpoint: reads one JSON-RPC body from stdin,
# answers with a fixed session id header. Every request line is logged
# with the session header the client sent.
body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
method=$(printf '%s' "$body" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
id=$(printf '%s' "$body" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
echo "REQUEST method=$method sid=$HTTP_MCP_SESSION_ID" >> "__LOG__"
printf 'Mcp-Session-Id: fixed-session-777\r\n'
printf 'Content-Type: application/json\r\n\r\n'
case "$method" in
	initialize)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"web-mcp","version":"1.0"}}}' "$id"
		;;
	tools/list)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[{"name":"web_search","description":"search the web","inputSchema":{"type":"object"}}]}}' "$id"
		;;
	tools/call)
		printf '{"jsonrpc":"2.0","id":%s,"result":{"content":[{"type":"text","text":"web-result"}]}}' "$id"
		;;
	*)
		printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"nope"}}' "$id"
		;;
esac
CGI
	sed -i "s|__LOG__|$ROOT/requests.log|" "$WEB/cgi-bin/mcp"
	chmod +x "$WEB/cgi-bin/mcp"

	httpd -f -p "127.0.0.1:$PORT" -h "$WEB" >/dev/null 2>&1 &
	HTTPD_PID=$!
	sleep 1

	testing "mcpc connect over streamable http" \
		"BA_HOME=$PWD/mc.home mcpc connect http://127.0.0.1:$PORT/cgi-bin/mcp @web 2>&1" \
		"connected @web\n" \
		"" ""

	testing "mcpc tools-call over http" \
		"BA_HOME=$PWD/mc.home mcpc @web tools-call web_search q=hello 2>&1" \
		'{"content":[{"type":"text","text":"web-result"}]}\n' \
		"" ""

	testing "mcpc keeps one session id across calls (daemon-held)" \
		"grep -c 'sid=fixed-session-777' $ROOT/requests.log" \
		"3\n" \
		"" ""

	# a server that answers notifications with 5xx fails the connect:
	# success is judged by the HTTP status, not by the empty body
	cat > "$WEB/cgi-bin/mcp500" <<'CGI500'
#!/bin/sh
body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
method=$(printf '%s' "$body" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
case "$method" in
	notifications/*)
		printf 'Status: 500 Internal Server Error\r\n\r\n'
		;;
	*)
		printf 'Mcp-Session-Id: s500\r\n'
		printf 'Content-Type: application/json\r\n\r\n'
		printf '{"jsonrpc":"2.0","id":1,"result":{}}'
		;;
esac
CGI500
	chmod +x "$WEB/cgi-bin/mcp500"

	testing "mcpc http notification answered 5xx fails the connect" \
		"BA_HOME=$PWD/mc.home mcpc connect http://127.0.0.1:$PORT/cgi-bin/mcp500 @n500 2>&1 | grep -o 'connect @n500 failed'; echo rc=\$?" \
		"connect @n500 failed
rc=0\n" \
		"" ""

	# a server that replies with an SSE body (event stream carrying the
	# JSON-RPC message events) must be understood
	cat > "$WEB/cgi-bin/mcpsse" <<'CGISSE'
#!/bin/sh
body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
method=$(printf '%s' "$body" | grep -o '"method":"[^"]*"' | head -1 | cut -d'"' -f4)
id=$(printf '%s' "$body" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
printf 'Content-Type: text/event-stream\r\n\r\n'
case "$method" in
	initialize)
		printf 'event: message\ndata: {"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"sse-mcp","version":"1.0"}}}\n\n' "$id"
		;;
	notifications/*)
		:
		;;
	tools/list)
		printf 'event: message\ndata: {"jsonrpc":"2.0","id":%s,"result":{"tools":[{"name":"sse_tool","description":"over sse","inputSchema":{"type":"object"}}]}}\n\n' "$id"
		;;
	tools/call)
		printf 'event: message\ndata: {"jsonrpc":"2.0","id":%s,"result":{"content":[{"type":"text","text":"sse-result"}]}}\n\n' "$id"
		;;
esac
CGISSE
	chmod +x "$WEB/cgi-bin/mcpsse"

	testing "mcpc connects over an SSE streamable-http endpoint" \
		"BA_HOME=$PWD/mc.home mcpc connect http://127.0.0.1:$PORT/cgi-bin/mcpsse @sse 2>&1" \
		"connected @sse\n" \
		"" ""

	testing "mcpc tools-call over sse" \
		"BA_HOME=$PWD/mc.home mcpc @sse tools-call sse_tool 2>&1" \
		'{"content":[{"type":"text","text":"sse-result"}]}\n' \
		"" ""

	kill $HTTPD_PID 2>/dev/null
	rm -rf "$ROOT"
else
	echo "SKIPPED: mcpc http e2e (httpd/CGI not enabled)"
fi

# === daemon lifecycle ===============================================

testing "mcpc daemon stop leaves no socket" \
	'BA_HOME=$PWD/mc.home mcpc daemon stop 2>&1; ls $PWD/mc.home/mcpc/daemon.sock 2>&1 | grep -c "No such" || true' \
	"daemon stopped
1\n" \
	"" ""

testing "mcpc works again after a restart (implicit spawn)" \
	'BA_HOME=$PWD/mc.home mcpc connect cmd:$PWD/echo-mcp.tmp.sh @echo2 2>&1 && BA_HOME=$PWD/mc.home mcpc daemon stop >/dev/null' \
	"connected @echo2\n" \
	"" ""

rm -rf mc.home mc2.home mc.e2e echo-mcp.tmp.sh echo-big.tmp.sh echo-die.tmp.sh mcpc-stdio.log

echo "mcpc: done"

exit $FAILCOUNT
