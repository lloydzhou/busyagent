#!/bin/sh
# testsuite/jq.tests - the tiny jq applet
#
# pure offline coverage of the path evaluator shared with oapi --jq.

. ./testing.sh

J='{"name":"fido","id":7,"alive":true,"tags":["a","b"],
"items":[{"id":1,"kind":"x"},{"id":2,"kind":"y"}],"meta":{"deep":{"v":"z"}}}'

testing "jq .field extracts a string" \
	"echo '$J' | jq '.name'" \
	'"fido"\n' \
	"" ""

testing "jq -r strips quotes" \
	"echo '$J' | jq -r '.name'" \
	"fido\n" \
	"" ""

testing "jq .field on a number" \
	"echo '$J' | jq '.id'" \
	"7\n" \
	"" ""

testing "jq nested path" \
	"echo '$J' | jq -r '.meta.deep.v'" \
	"z\n" \
	"" ""

testing "jq missing key yields null" \
	"echo '$J' | jq '.nope'" \
	"null\n" \
	"" ""

testing "jq array index" \
	"echo '$J' | jq -r '.tags[1]'" \
	"b\n" \
	"" ""

testing "jq array index out of range yields null" \
	"echo '$J' | jq '.tags[9]'" \
	"null\n" \
	"" ""

testing "jq .[] spreads an array" \
	"echo '$J' | jq -r '.tags[]'" \
	"a
b\n" \
	"" ""

testing "jq .a[].b walks array elements" \
	"echo '$J' | jq '.items[].id'" \
	"1
2\n" \
	"" ""

testing "jq [] over a non-array yields nothing" \
	"echo '{\"a\":1}' | jq -e '.a[]'; echo rc=\$?" \
	"rc=1\n" \
	"" ""

testing "jq . selects the root" \
	"echo '{\"a\":1}' | jq -e '.'; echo rc=\$?" \
	'{
  "a": 1
}
rc=0\n' \
	"" ""

testing "jq -e exits 1 on no output" \
	"echo '{\"a\":1}' | jq -e '.missing[]'; echo rc=\$?" \
	"rc=1\n" \
	"" ""

testing "jq invalid json fails" \
	"echo 'nope' | jq '.a' 2>&1 | grep -c 'invalid JSON'; echo rc=\$?" \
	"1
rc=0\n" \
	"" ""

testing "jq bad path fails" \
	"echo '{\"a\":1}' | jq '.a[' 2>&1; echo rc=\$?" \
	"jq: bad path '.a['
rc=1\n" \
	"" ""

testing "jq reads a file argument" \
	"echo '{\"a\":\"file-val\"}' > jqt.json && jq -r '.a' jqt.json && rm -f jqt.json" \
	"file-val\n" \
	"" ""

# pretty print (jq-style, 2-space indent) is the default; -c restores the
# compact single-line form
testing "jq pretty-prints nested objects" \
	"echo '{\"meta\":{\"deep\":{\"v\":\"z\"}}}' | jq '.meta'" \
	'{
  "deep": {
    "v": "z"
  }
}
' \
	"" ""

testing "jq -r still pretty-prints objects" \
	"echo '{\"a\":1}' | jq -r '.'" \
	'{
  "a": 1
}
' \
	"" ""

testing "jq -c keeps objects on one line" \
	"echo '{\"a\":1}' | jq -c '.'" \
	'{"a":1}\n' \
	"" ""

testing "jq pretty-prints empty containers compactly" \
	"echo '{\"a\":{},\"b\":[]}' | jq '.'" \
	'{
  "a": {},
  "b": []
}
' \
	"" ""

testing "jq with no PATH pretty-prints like jq 1.7+" \
	"echo '{\"a\":1}' | jq" \
	'{
  "a": 1
}
' \
	"" ""

# -r only affects top-level selected strings; container contents stay
# valid JSON with quotes kept
testing "jq -r keeps quotes inside objects and arrays" \
	"echo '{\"a\":\"x\",\"b\":[\"y\"]}' | jq -r ." \
	'{
  "a": "x",
  "b": [
    "y"
  ]
}
' \
	"" ""

# -c must serialize compactly, not echo the source slice
testing "jq -c compacts multi-line input" \
	"printf '{\\n  \"a\":  1,\\n  \"b\": [ 2 ]\\n}\\n' | jq -c ." \
	'{"a":1,"b":[2]}\n' \
	"" ""

testing "jq -cr still strips quotes from a top-level string" \
	"echo '\"hello\"' | jq -cr ." \
	'hello\n' \
	"" ""

testing "jq -rc order does not matter" \
	"echo '\"hi\"' | jq -rc ." \
	'hi\n' \
	"" ""

# one sequential pass over the array, not a rescan per index
testing "jq pretty-prints a 500-element array in one pass" \
	"awk 'BEGIN{s=\"[\";for(i=1;i<=500;i++)s=s (i>1?\",\":\"\") i;print s \"]\"}' | jq . | wc -l" \
	"502\n" \
	"" ""

# the match list grows dynamically: more than the initial 64 matches
# must all be printed (previously truncated silently at 64)
testing "jq .[] over a 100-element array prints every element" \
	"awk 'BEGIN{s=\"[\";for(i=1;i<=100;i++){if(i>1)s=s \",\";s=s i};s=s \"]\";print s}' | jq '.[]' | wc -l" \
	"100\n" \
	"" ""

echo "jq: done"

exit $FAILCOUNT
